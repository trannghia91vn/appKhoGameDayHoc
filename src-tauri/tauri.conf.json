{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kho game co Trang Tran",
  "version": "0.1.3",
  "identifier": "com.yeutre.game-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kho game cô Trang Trần",
        "width": 1360,
        "height": 900,
        "minWidth": 860,
        "minHeight": 760,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; frame-src 'self' ytasset: http://ytasset.localhost; child-src 'self' ytasset: http://ytasset.localhost; img-src 'self' data: asset: http://asset.localhost ytasset: http://ytasset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "3d181e0d-8dbd-578c-ae8f-e8477769a191"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "yeutregame"
        ]
      }
    }
  }
}
